<!DOCTYPE html>
<html>
  <head>
    <title>React Basics</title>
  </head>
  <body>
    <div class="js-container"></div>
    <script src="https://unpkg.com/supersimpledev/dayjs.js"></script>
    <script src="https://unpkg.com/supersimpledev/react.js"></script>
    <script src="https://unpkg.com/supersimpledev/react-dom.js"></script>

    <script src="https://unpkg.com/supersimpledev/babel.js"></script>
    <script type="text/babel">

    function ProductDetails({ productName,price,discountPrice,imageSrc }){
      return(
            <> 
              <div>
              <img src={imageSrc} width="80" />
              </div>
              <p>{productName}</p>
              { !discountPrice ? <p>Price: ${price}</p> :<del><p>Price: ${price}</p></del>}
              { discountPrice  ? <p>Discount Price: {discountPrice}</p> : <p></p>}
              <button>Add to Cart</button>
            </>
      )
    }

     function App(){
        return(
            <>
              <ProductDetails 
                imageSrc= "https://supersimple.dev/images/cotton-socks.png"
                productName="Cotton Socks" 
                price= {10.90} 
                discountPrice = {5.45}
              />
              <ProductDetails 
                imageSrc= "https://supersimple.dev/images/tennis-balls.png"
                productName="Tennis balls" 
                price= {6} 
              />
              <ProductDetails 
                imageSrc= "https://supersimple.dev/images/plain-t-shirt.png"
                productName="Plain T-shirt" 
                price= {7.99} 
              />              
            </>
        ) 
     }


      const container = document.querySelector('.js-container');
      const root =  ReactDOM.createRoot(container)
      root.render(<App />);
    </script>
  </body>
</html>
